  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProjectIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectIn",
        "description": "Cuerpo de ``POST /projects``. ``name`` se normaliza antes de validar."
      },
      "ProjectOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "ProjectOut",
        "description": "Proyecto que devuelve la API: exactamente ``id``, ``name`` y ``description``."
      },
      "ProjectPatch": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProjectPatch",
        "description": "Cuerpo de ``PATCH /projects/{id}``: todos los campos son opcionales.\n\nUn campo ausente no cambia; ``description`` puede fijarse a ``null``. Anular\n``name`` no está permitido: lo rechaza la ruta con ``422``."
      },
      "StateOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "code"
        ],
        "title": "StateOut",
        "description": "Estado tal y como lo devuelve ``GET /states``: solo ``id`` y ``code``."
      },
      "TaskIn": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "project_id": {
            "type": "integer",
            "title": "Project Id"
          },
          "state_id": {
            "type": "integer",
            "title": "State Id"
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "project_id",
          "state_id"
        ],
        "title": "TaskIn",
        "description": "Cuerpo de ``POST /tasks`` (v2). ``title`` se normaliza antes de validar.\n\n``due_at`` es opcional; omitirlo conserva compatibilidad v1. Con zona\nhoraria se normaliza a UTC; sin zona se rechaza con ``422``.\n\n``priority`` es un entero opcional 1..3; omitirlo guarda ``null``. Un valor\nfuera de rango se rechaza con ``422``."
      },
      "TaskOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "project_id": {
            "type": "integer",
            "title": "Project Id"
          },
          "state_id": {
            "type": "integer",
            "title": "State Id"
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "project_id",
          "state_id",
          "due_at",
          "priority"
        ],
        "title": "TaskOut",
        "description": "Tarea que devuelve la API (v2): incluye ``due_at`` y ``priority``.\n\n``due_at`` se serializa siempre en UTC, con sufijo ``Z`` y sin\nmicrosegundos: ``2026-03-01T09:00:00Z``. Ausente se devuelve como ``null``.\n``priority`` es ``int`` (1..3) o ``null``."
      },
      "TaskPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "state_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "State Id"
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "TaskPatch",
        "description": "Cuerpo de ``PATCH /tasks/{id}`` (v2): todos los campos son opcionales.\n\nUn campo ausente no cambia; ``description``, ``due_at`` y ``priority`` pueden\nfijarse a ``null``. Anular ``title``, ``project_id`` o ``state_id`` no está\npermitido: lo rechaza la ruta con ``422``. Un ``due_at`` sin zona horaria\ntambién, y un ``priority`` fuera de 1..3."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
