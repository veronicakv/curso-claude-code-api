# Valores locales ficticios para desarrollo. Copia a .env y ajusta si lo necesitas.
# No pongas secretos reales aqui.

# Usuario de PostgreSQL.
POSTGRES_USER=taskflow

# Contrasena de PostgreSQL (ficticia, solo para local).
POSTGRES_PASSWORD=taskflow_local_dev

# Nombre de la base de datos.
POSTGRES_DB=taskflow

# Puerto expuesto en el host para PostgreSQL.
POSTGRES_PORT=5432
